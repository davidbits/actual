#!/bin/bash -e

cd "$(dirname "$0")/.."

# Translations are local build inputs. Never clone or pull repositories here.
# Keep the old flag accepted for existing local scripts.
for arg in "$@"; do
  case "$arg" in
    --skip-translations) ;;
    *) echo "Unknown argument: $arg" >&2; exit 1 ;;
  esac
done

yarn lage build:browser --to=@actual-app/web
