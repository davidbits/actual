{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "rules": {
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "duplicates": "off",
  },
  "workspaces": {
    ".": {
      "entry": ["bin/*.mts"],
      "ignore": ["lage.config.js", ".claude/**", ".agents/**"],
    },
    "packages/api": {
      "entry": ["index.browser.ts", "browser-worker.ts", "e2e/**/*.{ts,mjs}"],
      "ignore": ["typings.ts"],
      "ignoreDependencies": [
        "@actual-app/crdt",
        "better-sqlite3",
        "uuid",
        "@jlongster/sql.js",
      ],
    },
    "packages/crdt": {
      "ignore": ["src/proto/**"],
      "ignoreDependencies": ["@bufbuild/protoc-gen-es"],
    },
    "packages/desktop-client": {
      "entry": [
        "bin/*.mjs",
        "globals.ts",
        "src/globals.ts",
        "src/build-shims.js",
      ],
      "ignore": ["playwright.config.d.ts"],
    },
    "packages/loot-core": {
      "entry": ["src/**/index-types.ts", "src/mocks/**"],
      "ignoreDependencies": [
        "assert",
        "browserify-zlib",
        "buffer",
        "crypto-browserify",
        "path-browserify",
        "stream-browserify",
        "timers-browserify",
        "util",
      ],
    },
    "packages/sync-server": {
      "entry": [
        "app.ts",
        "src/app.ts",
        "bin/**/*.js",
        "src/scripts/**/*.{js,ts}",
        "src/app-*/app-*.{ts,js}",
      ],
    },
  },
}
